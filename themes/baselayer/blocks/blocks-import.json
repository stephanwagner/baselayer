                "label": "Slide content alignment",
                "required": false,
                "width": "100",
                "default_value": "left",
                "options": [
                    {
                        "value": "left",
                        "label": "Left"
                    },
                    {
                        "value": "center",
                        "label": "Center"
                    },
                    {
                        "value": "right",
                        "label": "Right"
                    }
                ],
                "conditional_logic": {
                    "enabled": true,
                    "groups": [
                        [
                            {
                                "field": "fld_sl_has_content",
                                "operator": "checked",
                                "value": ""
                            }
                        ]
                    ]
                }
            },
            {
                "id": "fld_sl_content_mobile",
                "type": "toggle",
                "name": "content_visibility_mobile",
                "label": "Slide content visibility",
