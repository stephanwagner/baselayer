    {
        "type": "block",
        "title": "Accordion",
        "fields": [
            {
                "id": "fld_acc_title",
                "type": "text",
                "name": "title",
                "label": "Title",
                "required": true,
                "width": "100",
                "default_value": ""
            },
            {
                "id": "fld_acc_id",
                "type": "text",
                "name": "id",
                "label": "ID",
                "required": false,
                "width": "100",
                "default_value": "",
                "description": "Optional ID. Use #my-id to link directly to this accordion. When opened via the URL, the accordion opens automatically and scrolls into view."
            },
            {
                "id": "fld_acc_open",
                "type": "toggle",
                "name": "accordion_is_open",
                "label": "Open by default",
                "required": false,
                "width": "100",
                "default_value": "",
                "content": "Open by default",
                "hide_label": true
            },
            {
                "id": "fld_acc_close",
                "type": "toggle",
                "name": "close_neighbouring_accordions",
                "label": "Close adjacent accordions",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "Automatically closes adjacent open accordions when this one is opened.",
                "content": "Close adjacent accordions",
                "hide_label": true
            },
            {
                "id": "fld_acc_scroll",
                "type": "toggle",
                "name": "scroll_to_accordion_top",
                "label": "Scroll to accordion on open",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "Automatically scrolls to the start of the accordion when opened. Especially useful on mobile with long content.",
                "content": "Scroll to accordion on open",
                "hide_label": true
            },
            {
                "id": "fld_acc_advanced",
                "type": "toggle",
                "name": "has_advanced_settings",
                "label": "Advanced settings",
                "required": false,
                "width": "100",
                "default_value": "",
                "content": "Advanced settings",
                "hide_label": true
            },
            {
                "id": "fld_acc_advanced_area",
                "type": "section",
                "label": "Advanced settings",
                "show_title": false,
                "design": "outline",
                "width": "100",
                "children": [
                    {
                        "id": "fld_acc_faq",
                        "type": "toggle",
                        "name": "add_to_faq_schema",
                        "label": "Add to FAQ schema",
                        "required": false,
                        "width": "100",
                        "default_value": "",
                        "description": "Uses this accordion’s content as question and answer for structured FAQ data. Only use for real FAQs.",
                        "content": "Add to FAQ schema",
                        "hide_label": true
                    }
                ],
                "conditional_logic": {
                    "enabled": true,
                    "groups": [
                        [
                            {
                                "field": "fld_acc_advanced",
                                "operator": "checked",
                                "value": ""
                            }
                        ]
                    ]
                }
            }
        ],
