    {
        "type": "block",
        "title": "Slider",
        "fields": [
            {
                "id": "fld_sl_per_view",
                "type": "number",
                "name": "slides_per_view",
                "label": "Visible slides",
                "required": false,
                "width": "50",
                "default_value": "1",
                "min": "1",
                "max": "12"
            },
            {
                "id": "fld_sl_per_group",
                "type": "number",
                "name": "slides_per_group",
                "label": "Slides per scroll",
                "required": false,
                "width": "50",
                "default_value": "1"
            },
            {
                "id": "fld_sl_space",
                "type": "number",
                "name": "space_between",
                "label": "Gap between slides",
                "required": false,
                "width": "100",
                "default_value": "16",
                "min": "0",
                "max": "128",
                "suffix": "px"
            },
            {
                "id": "fld_sl_ratio",
                "type": "select",
                "name": "ratio",
                "label": "Aspect ratio",
                "required": false,
                "width": "100",
                "default_value": "2-1",
                "options": [
                    {
                        "value": "1-1",
                        "label": "Square (1:1)"
                    },
                    {
                        "value": "4-3",
                        "label": "Classic (4:3)"
                    },
                    {
                        "value": "3-2",
                        "label": "Photo (3:2)"
                    },
                    {
                        "value": "2-1",
                        "label": "Panorama (2:1)"
                    },
                    {
                        "value": "16-9",
                        "label": "Widescreen (16:9)"
                    },
                    {
                        "value": "21-9",
                        "label": "Cinema (21:9)"
                    },
                    {
                        "value": "custom",
                        "label": "Custom"
                    }
                ]
            },
            {
                "id": "fld_sl_ratio_x",
                "type": "number",
                "name": "ratio_x",
                "label": "Width",
                "required": false,
                "width": "50",
                "default_value": "1",
                "min": "1",
                "prefix": "X",
                "conditional_logic": {
                    "enabled": true,
                    "groups": [
                        [
                            {
                                "field": "fld_sl_ratio",
                                "operator": "==",
                                "value": "custom"
                            }
                        ]
                    ]
                }
            },
            {
                "id": "fld_sl_ratio_y",
                "type": "number",
                "name": "ratio_y",
                "label": "Height",
                "required": false,
                "width": "50",
                "default_value": "1",
                "min": "1",
                "prefix": "Y",
                "conditional_logic": {
                    "enabled": true,
                    "groups": [
                        [
                            {
                                "field": "fld_sl_ratio",
                                "operator": "==",
                                "value": "custom"
                            }
                        ]
                    ]
                }
            },
            {
                "id": "fld_sl_anim",
                "type": "button_group",
                "name": "animation",
                "label": "Animation",
                "required": false,
                "width": "100",
                "default_value": "slide",
                "options": [
                    {
                        "value": "slide",
                        "label": "Slide"
                    },
                    {
                        "value": "fade",
                        "label": "Fade"
                    }
                ]
            },
            {
                "id": "fld_sl_nav",
                "type": "toggle",
                "name": "navigation",
                "label": "Navigation",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "Shows navigation arrows for the previous and next slide.",
                "content": "Navigation",
                "hide_label": true
            },
            {
                "id": "fld_sl_pag",
                "type": "toggle",
                "name": "pagination",
                "label": "Pagination",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "Shows the current slider position below the slides.",
                "content": "Pagination",
                "hide_label": true
            },
            {
                "id": "fld_sl_dyn",
                "type": "toggle",
                "name": "dynamic_bullets",
                "label": "Dynamic pagination",
                "required": false,
                "width": "100",
                "default_value": "",
                "description": "Shows only pagination dots near the current slide.",
                "content": "Dynamic pagination",
                "hide_label": true
            },
            {
                "id": "fld_sl_loop",
                "type": "toggle",
                "name": "loop",
                "label": "Loop",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "After the last slide, the slider starts again from the beginning.",
                "content": "Loop",
                "hide_label": true
            },
            {
                "id": "fld_sl_auto",
                "type": "toggle",
                "name": "autoplay",
                "label": "Autoplay",
                "required": false,
                "width": "100",
                "default_value": "1",
                "description": "The slider starts automatically. User actions such as swiping or clicking interrupt autoplay.",
                "content": "Autoplay",
                "hide_label": true
            },
            {
                "id": "fld_sl_delay",
                "type": "number",
                "name": "autoplay_delay",
